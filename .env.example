# Rename to .env, or pass these environment variables via systemd/Docker.
APP_ADDR=127.0.0.1:8080
DATA_DIR=./data
# Required on first start; remove after admin account is initialized
ADMIN_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_PASSWORD
# Set APP_PUBLIC_URL to the external HTTPS URL when behind a reverse proxy
APP_PUBLIC_URL=http://localhost:8080
# Set to true only when serving through HTTPS
COOKIE_SECURE=false
# Set to true for public monitoring; loopback, private and metadata IPs are rejected
ALLOW_PRIVATE_TARGETS=false

# Optional: use a trusted HTTPS Telegram Relay when direct api.telegram.org is blocked.
# Configure both values together; leave both absent for direct Telegram Bot API.
# RELAY_URL=https://your-relay.example.workers.dev
# RELAY_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET
